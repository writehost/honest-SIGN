<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="scada_background">#F4F2EA</color>
    <style name="Theme.Scada" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/scada_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Scada.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/scada_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Scada</item>
    </style>
</resources>
